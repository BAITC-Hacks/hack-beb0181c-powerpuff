              "pm.test('Превышение остатка',()=>{pm.response.to.have.status(409);pm.expect(pm.response.json().code).to.eql('INSUFFICIENT_STOCK');});"
            ]
          }
        }
      ]
    },
    {
      "name": "11. Другая сессия",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/session"
      },
      "event": [
        {
          "listen": "test",
          "script": {
