          }
        ],
        "url": "{{baseUrl}}/api/cart/items/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"requestId\":\"{{$guid}}\",\"quantity\":{{excess}},\"cartVersion\":{{cartVersion}}}",
          "options": {
