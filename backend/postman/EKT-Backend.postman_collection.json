        "url": "{{baseUrl}}/api/cart/proposals",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\"requestId\":\"{{proposalRequestId}}\",\"productId\":{{productId}},\"quantity\":{{quantity}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('proposalRequestId', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Предложение ожидает подтверждения',()=>{pm.expect(b.status).to.equal('PENDING');pm.expect(String(b.productId)).to.equal(String(pm.variables.get('productId')));pm.expect(Number(b.quantity)).to.equal(Number(pm.variables.get('quantity')));pm.expect(b.revision).to.be.at.least(1);});",
              "pm.collectionVariables.set('proposalId',b.id);pm.collectionVariables.set('proposalRevision',String(b.revision));"
            ]
          }
        }
      ]
    },
    {
      "name": "11. До подтверждения корзина не меняется",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/cart",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test('Предложение не добавило товар',()=>pm.expect(b.items).to.have.lengthOf(0));"
            ]
          }
        }
      ]
    },
    {
      "name": "12. Явное подтверждение",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/cart/proposals/{{proposalId}}/confirm",
        "description": "Запуск коллекции означает явное подтверждение первоначального предложения в LOCAL_DEMO. При изменении условий Runner останавливается: новая ревизия не подтверждается автоматически.",
        "body": {
          "mode": "raw",
          "raw": "{\"revision\":{{proposalRevision}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "if(b.requiresConfirmation) {",
              " pm.collectionVariables.set('proposalRevision',String(b.proposal.revision));",
              " pm.test('Изменение условий не меняет корзину',()=>{pm.expect(b.added).to.equal(false);pm.expect(b.cart.items).to.have.lengthOf(0);});",
              " pm.test('Нужно вручную проверить новые условия и повторить шаг 12',()=>pm.expect.fail('Цена/остаток изменились. Автоподтверждение новой ревизии отключено.'));",
              " pm.execution.setNextRequest(null);",
              "} else {",
              " pm.test('Товар добавлен в нужном количестве',()=>{pm.expect(b.added).to.equal(true);pm.expect(b.proposal.status).to.equal('CONFIRMED');pm.expect(b.cart.items).to.have.lengthOf(1);pm.expect(String(b.cart.items[0].productId)).to.equal(String(pm.variables.get('productId')));pm.expect(Number(b.cart.items[0].quantity)).to.equal(Number(pm.variables.get('quantity')));});",
              " pm.collectionVariables.set('confirmed','true');",
              " pm.collectionVariables.set('snapshot',JSON.stringify(b.cart.items));",
              " pm.test('Есть ссылка на локальную корзину',()=>pm.expect(b.cart.cartUrl).to.match(/^https?:\\/\\/.+\\/cart$/));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "13. Повторное подтверждение без дубля",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/cart/proposals/{{proposalId}}/confirm",
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\"revision\":{{proposalRevision}}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Результат идемпотентен',()=>{pm.expect(b.added).to.equal(true);pm.expect(b.requiresConfirmation).to.equal(false);pm.expect(b.cart.items).to.deep.equal(JSON.parse(pm.variables.get('snapshot')));});"
            ]
          }
        }
      ]
    },
    {
