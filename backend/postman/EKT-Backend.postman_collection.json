    {
      "name": "01. Health приложения",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": ""
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "['sessionId','proposalId','proposalRevision','confirmed','article','articleEncoded','stock','excessQuantity','proposalRequestId','messageId1','messageId2','llmAvailable','chatSessionId','snapshot'].forEach(k => pm.collectionVariables.set(k, ''));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"Приложение работает\", () => pm.expect(b.status).to.equal('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "02. Health PostgreSQL",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health",
        "description": "Actuator настроен show-details=never. UP проверяет общий health с DataSource, но не раскрывает components.db. Следующий запрос дополнительно читает PostgreSQL."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"Health UP (включая настроенный индикатор БД)\", () => pm.expect(b.status).to.equal('UP'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03. Список из PostgreSQL и выбор товара",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/catalog/products?page=0&size=100",
        "description": "productId можно задать заранее. Если пустой, выбирается доступный товар из первых 100 сохранённых записей. Новая сессия будет создана позже."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test(\"Непустой импортированный каталог\", () => {pm.expect(b.items).to.be.an('array').that.is.not.empty; pm.expect(b.totalElements).to.be.above(0);});",
              "let productId = pm.variables.get('productId');",
              "const selected = productId ? b.items.find(x => String(x.id) === String(productId)) : b.items.find(x => x.quantity !== null && Number(x.quantity) > 0 && x.price !== null && x.article);",
              "if (!productId && selected) {productId = String(selected.id);pm.collectionVariables.set('productId', productId);}",
              "if (!productId) {pm.test('Нужен доступный товар; импортируйте каталог или задайте productId',()=>pm.expect.fail('Нет подходящего товара'));pm.execution.setNextRequest(null);}"
            ]
          }
        }
      ]
    },
    {
      "name": "04. Сохранённая карточка и артикул",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/catalog/products/{{productId}}",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Совпадает ID и сохранён артикул',()=>{pm.expect(String(b.product.id)).to.equal(String(pm.variables.get('productId')));pm.expect(b.product.article).to.be.a('string').that.is.not.empty;});",
              "pm.collectionVariables.set('article', b.product.article);",
              "pm.collectionVariables.set('articleEncoded', encodeURIComponent(b.product.article));"
            ]
          }
        }
      ]
    },
    {
      "name": "05. Поиск точного артикула",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/search?q={{articleEncoded}}&page=0&size=20",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Найден выбранный товар',()=>pm.expect(b.items.some(x=>String(x.id)===String(pm.variables.get('productId')))).to.equal(true));",
              "pm.test('Точный артикул ранжируется первым',()=>pm.expect(b.items[0].article.toLowerCase()).to.equal(String(pm.variables.get('article')).toLowerCase()));"
            ]
          }
        }
      ]
    },
    {
      "name": "06. Свежая карточка EKT и количество",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "description": "Проверяет реальный EKT API. Если цена или остаток недоступны, тест падает, а не подменяет данные. quantity можно задать явно; иначе берётся KRATNOST_MIN либо 1, как для демонстрационного товара."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Карточка EKT доступна для покупки',()=>{pm.expect(String(b.id)).to.equal(String(pm.variables.get('productId')));pm.expect(b.price).to.be.a('number').at.least(0);pm.expect(b.quantity).to.be.a('number').above(0);});",
              "const step = b.properties && b.properties.KRATNOST_MIN != null ? Number(String(b.properties.KRATNOST_MIN).replace(',', '.')) : 1;",
              "if (!pm.variables.get('quantity')) pm.collectionVariables.set('quantity', String(step));",
              "pm.test('Количество соответствует остатку и кратности',()=>{const q=Number(pm.variables.get('quantity'));pm.expect(Number.isFinite(step) && step>0).to.equal(true);pm.expect(q).to.be.above(0).and.at.most(Number(b.quantity));pm.expect(Math.abs(q/step-Math.round(q/step))).to.be.below(1e-7);});",
              "pm.collectionVariables.set('stock',String(b.quantity));"
            ]
          }
        }
      ]
    },
    {
      "name": "07. Аналоги и объяснение",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/products/{{analogProductId}}/analogs",
        "description": "Пустая выдача допустима для конфликтных/неполных характеристик, но не считается успешной проверкой положительного подбора. requireAnalogs=true требует минимум один результат."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('analogProductId')) pm.collectionVariables.set('analogProductId',pm.variables.get('productId'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Есть список и объяснение результата',()=>{pm.expect(b.items).to.be.an('array');pm.expect(b.message).to.be.a('string').that.is.not.empty;});",
              "if (b.items.length) {",
              " pm.test('Каждый аналог объяснён',()=>b.items.forEach(x=>{pm.expect(x.explanation).to.be.a('string').that.is.not.empty;pm.expect(x.matchedCharacteristics).to.be.an('array').that.is.not.empty;pm.expect(x.product.product.quantity).to.be.above(0);}));",
              "} else if(String(pm.variables.get('requireAnalogs'))==='true') {",
              " pm.test('Есть хотя бы один аналог',()=>pm.expect.fail('В выборке нет совместимых кандидатов'));",
              "} else {pm.test.skip('НЕ ПРОВЕРЕНО: положительный подбор аналогов — нет кандидатов в текущей выборке',()=>{});}"
            ]
          }
        }
      ]
    },
    {
      "name": "08. Создать сессию",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/session",
        "description": "В API нет публичного sessionId UUID: переменная sessionId хранит возвращённый token и передаётся в Authorization. Новый токен получается при каждом запуске."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test('Получен Bearer-токен, сессия не истекла',()=>{pm.expect(b.token).to.be.a('string').that.is.not.empty;pm.expect(b.tokenType).to.equal('Bearer');pm.expect(Date.parse(b.expiresAt)).to.be.above(Date.now());});",
              "pm.collectionVariables.set('sessionId', b.token);",
              "pm.collectionVariables.set('chatSessionId', b.token);"
            ]
          }
        }
      ]
    },
