          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409',()=>pm.response.to.have.status(409));",
              "const b=pm.response.json();",
              "pm.test('Причина именно INSUFFICIENT_STOCK',()=>pm.expect(b.code).to.equal('INSUFFICIENT_STOCK'));"
            ]
          }
        }
      ]
    },
    {
      "name": "16. Итоговая корзина не изменилась",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{sessionId}}"
          }
        ],
        "url": "{{baseUrl}}/api/cart",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "",
              "pm.test(\"Корзина содержит ровно выбранное количество\", () => {",
              " const rows = b.items.filter(x => String(x.productId) === String(pm.variables.get('productId')));",
              " pm.expect(rows).to.have.lengthOf(1);",
              " pm.expect(Number(rows[0].quantity)).to.equal(Number(pm.variables.get('quantity')));",
              " pm.expect(b.items).to.have.lengthOf(1);",
              "});",
              "",
              "pm.test('Отказ не изменил состав и цену',()=>pm.expect(b.items).to.deep.equal(JSON.parse(pm.variables.get('snapshot'))));",
              "pm.test('Это локальная корзина без резерва',()=>{pm.expect(b.mode).to.equal('LOCAL_DEMO');pm.expect(b.stockReserved).to.equal(false);});"
            ]
          }
        }
      ]
