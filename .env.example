# Скопируйте в .env в корне репозитория. Не коммитьте .env.
# Compose читает .env; эти же DB_* задайте в конфигурации запуска IDE.
DB_URL=jdbc:postgresql://localhost:5432/hackdb
DB_USERNAME=ekt_local
# Замените заглушку. Кавычки сохраняют специальные символы буквально.
DB_PASSWORD='replace_with_local_password'
EKT_ENABLED=false
EKT_BASE_URL=https://ekt.kz
EKT_USERNAME=
EKT_PASSWORD=
CORS_ORIGINS=http://localhost:5173

# Если 5432 занят, измените DB_PORT и порт в DB_URL одинаково.
DB_PORT=5432
